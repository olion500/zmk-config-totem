/*                KEY POSITIONS

  ╭─────────────────────╮ ╭─────────────────────╮
  │ LT4 LT3 LT2 LT1 LT0 │ │ RT0 RT1 RT2 RT3 RT4 │
  │ LM4 LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 RM4 │
  │ LB4 LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 RB4 │
  ╰───────╮ LH2 LH1 LH0 │ │ RH0 RH1 RH2 ╭───────╯
          ╰─────────────╯ ╰─────────────╯ */

#define COMBO_TERM_FAST 18
#define COMBO_TERM_SLOW 30

#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50

/* left hand - Horizontal combos */
// `lalt` / `ralt` both emit RIGHT_ALT (Korean 한/영 IME toggle). Names mark
// which hand triggers the combo, not which Alt keycode is produced.
ZMK_COMBO(lalt,  &kp RIGHT_ALT,LT3 LT4,     DEF NAV SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(esc,   &kp ESC,      LT3 LT2,     DEF NAV SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)

// Tab overlaps HRM positions (LM3/LM2). Wrapped as hml so mod chords on the
// same fingers (Ctrl+Alt etc.) still work.
ZMK_COMBO(tab,   &hml LS(LALT)TAB, LM3 LM2, DEF NAV SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)

ZMK_COMBO(bslh,  &kp BSLH,     LB1 LB0,     DEF NAV SYM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

ZMK_COMBO(cut,   &kp LC(X),    LB3 LB1,     DEF NAV SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(copy,  &kp LC(INS),  LB3 LB2,     DEF NAV SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(paste, &kp LS(INS),  LB2 LB1,     DEF NAV SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)

/* right hand - Horizontal combos */
ZMK_COMBO(ralt,  &kp RIGHT_ALT,RT3 RT4,     DEF NAV SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(bspc,  &kp BSPC,     RT2 RT3,     DEF NAV SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(fslh,  &kp FSLH,     RB0 RB1,     DEF NAV SYM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

// Parentheses combo uses a mod-morph to emit < and > when shift is held, so we
// don't need separate gt/lt combos on the same chord. Kept on HRM positions
// intentionally; require-prior-idle + balanced HRM prevents misfires.
ZMK_COMBO(lpar,  &lpar_lt,     RM1 RM2,     DEF NAV SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rpar,  &rpar_gt,     RM2 RM3,     DEF NAV SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)

// [ ] on Base/Sym — { } on Nav only. Different chord on different layer
// gives bracket vs brace from the same finger pattern.
ZMK_COMBO(lbkt,  &kp LBKT,     RB1 RB2,     DEF     SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbkt,  &kp RBKT,     RB2 RB3,     DEF     SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(lbrc,  &kp LBRC,     RB1 RB2,         NAV    , COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbrc,  &kp RBRC,     RB2 RB3,         NAV    , COMBO_TERM_FAST, COMBO_IDLE_FAST)
