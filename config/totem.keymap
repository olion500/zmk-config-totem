#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/hid_usage_pages.h>
#include "zmk-helpers/helper.h"
#include "totem_defs.dtsi"

// Reuse urob's mod-morph helper so the paren combos can emit < and > when
// shift is held, avoiding conflicting gt/lt combos on the same chord.
#define SIMPLE_MORPH(NAME, MOD, BINDING1, BINDING2)                            \
  ZMK_MOD_MORPH(NAME, mods = <(MOD_L##MOD | MOD_R##MOD)>;                      \
                bindings = <BINDING1>, <BINDING2>;)

SIMPLE_MORPH(lpar_lt, SFT, &kp LPAR, &kp LT)
SIMPLE_MORPH(rpar_gt, SFT, &kp RPAR, &kp GT)
ZMK_KEY_REPEAT(repeat, usage-pages = <HID_USAGE_KEY HID_USAGE_CONSUMER>;)

#include "combos.dtsi"

ZMK_CONDITIONAL_LAYER(device, 1 2, 3)

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
               &kp Q              &kp W              &kp E               &kp R              &kp T         &kp Y              &kp U              &kp I               &kp O              &kp P
               &hml LGUI A        &hml LALT S        &hml LCTL D         &hml LSFT F        &kp G         &kp H              &hmr RSFT J        &hmr RCTL K         &hmr RALT L        &hmr RGUI SEMI
&kp RIGHT_ALT  &kp Z              &kp X              &kp C               &kp V              &kp B         &kp N              &kp M              &kp COMMA           &kp DOT            &kp FSLH         &kp APOS
                                                     &repeat             &mo 1              &kp SPACE                        &kp ENTER          &mo 2               &repeat
            >;
        };

        nav_num {
            display-name = "Nav/Num";
            bindings = <
                   &trans              &kp N7              &kp N8              &kp N9              &trans               &trans           &trans            &trans            &trans            &trans
                   &kp N0              &kp N4              &kp N5              &kp N6              &trans               &kp LEFT         &kp DOWN          &kp UP            &kp RIGHT         &trans
&trans             &trans              &kp N1              &kp N2              &kp N3              &trans               &trans           &trans            &trans            &trans            &trans            &trans
                                                      &trans            &trans            &trans            &trans            &trans            &trans
            >;
        };

        sym_func {
            display-name = "Sym/Fn";
            bindings = <
           &trans         &trans                &trans                 &trans            &trans            &trans    &trans            &trans    &trans   &trans
           &trans         &trans                &trans                 &trans            &trans            &trans    &trans            &trans    &trans   &trans
&trans      &trans        &trans                &trans                &trans             &trans            &trans    &trans            &trans    &trans   &trans  &trans
                                                &trans                 &trans            &trans            &trans    &trans            &trans
            >;
        };

        device {
            display-name = "Device";
            bindings = <
       &none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none    &none         &none         &none         &none         &none
&none  &none       &none                 &none                 &none             &none    &none         &none         &none         &none         &none         &bt BT_CLR
                                         &none                 &none             &none    &none         &none         &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

};
